menuconfig SND_RUST
	bool "Rust support for ALSA sound"
	depends on RUST
	depends on SND=y
	help
	  Enable Rust-based ALSA sound drivers.

	  If unsure, say N.

if SND_RUST

# Hidden bool: forces SND_PCM=y whenever any Rust ALSA driver is enabled.
# rust/kernel/sound/pcm.rs is compiled into vmlinux unconditionally (no
# #[cfg] gate in sound/mod.rs) whenever CONFIG_SND=y.  It references
# snd_pcm_* symbols that must therefore also live in vmlinux.  A bool
# selecting a tristate always propagates y, ensuring SND_PCM=y.
config SND_RUST_PCM_FORCE
	bool
	default y
	select SND_PCM

config SND_RUST_DUMMY
	tristate "Dummy sound driver (Rust)"
	select SND_PCM
	help
	  Rust implementation of a dummy ALSA sound card with a PCM device
	  and two mixer controls (master volume and master switch), backed
	  by a faux device and an hrtimer-based period simulator.

	  To compile this as a module, choose M here: the module will be
	  called snd-rust-dummy.

	  If unsure, say N.

config SND_RUST_ENS1370
	tristate "Ensoniq AudioPCI ES1370 (Rust)"
	depends on PCI
	select SND_PCM
	select SND_AK4531_CODEC
	help
	  Rust port of the ENS1370 path of the Ensoniq AudioPCI driver,
	  targeting QEMU es1370 emulation. Implements two PCM devices
	  (DAC2+ADC variable-rate, DAC1 fixed-rate), AK4531 codec mixer,
	  and shared IRQ handler.

	  To compile this as a module, choose M here: the module will be
	  called snd-rust-ens1370.

	  If unsure, say N.

# Hidden bool: forces SND_AK4531_CODEC=y whenever SND_RUST_ENS1370 is
# enabled (y or m).  A bool selecting a tristate always propagates y,
# so the kernel crate can safely include the AK4531 abstraction code that
# calls snd_ak4531_mixer / snd_ak4531_suspend / etc. -
# symbols that must reside in vmlinux (not in a module).
config SND_RUST_ENS1370_FORCE_AK4531
	bool
	default y if SND_RUST_ENS1370
	select SND_AK4531_CODEC

config SND_RUST_INTEL8X0
	tristate "Intel ICH AC97 sound driver (Rust)"
	depends on PCI
	select SND_PCM
	help
	  Rust port of the Intel ICH AC97 driver (intel8x0), targeting
	  QEMU's ICH AC97 emulation (82801AA/ICH). Implements two PCM
	  devices (stereo playback + capture, mono mic capture) and AC97
	  codec mixer via snd_ac97_mixer().

	  To compile this as a module, choose M here: the module will be
	  called snd-rust-intel8x0.

	  If unsure, say N.

# Hidden bool: forces SND_AC97_CODEC=y whenever SND_RUST_INTEL8X0 is
# enabled (y or m).  A bool selecting a tristate always propagates y,
# so the kernel crate can safely include the AC97 abstraction code that
# calls snd_ac97_bus / snd_ac97_mixer / snd_ac97_suspend / etc. -
# symbols that must reside in vmlinux (not in a module).
config SND_RUST_INTEL8X0_FORCE_AC97
	bool
	default y if SND_RUST_INTEL8X0
	select SND_AC97_CODEC

config SND_RUST_USB_AUDIO
	tristate "USB Audio driver (Rust)"
	depends on USB=y
	select SND_PCM
	help
	  Rust implementation of the USB Audio Class (UAC 1/2) PCM streaming
	  path.  Provides playback and capture for generic USB audio devices.
	  MIDI, MIDI2, and the AudioControl mixer interface are not yet
	  implemented.

	  Note: requires CONFIG_USB=y (built-in USB support) because the Rust
	  USB bindings live in the vmlinux kernel crate.

	  To compile this as a module, choose M here: the module will be
	  called snd-rust-usb-audio.

	  If unsure, say N.

endif # SND_RUST
